#!/bin/bash

EMAIL_TO="m.hickling@hotmail.co.uk"

PROJECTS_DIR="$HOME/Projects"
DOWNLOADS_DIR="$HOME/Downloads"
BACKUPS_DIR="$HOME/tools/backups"
LOGS_DIR="$HOME/tools/logs"

mkdir -p "$LOGS_DIR"

{
echo "Subject: Daily Dev Report"
echo "To: $EMAIL_TO"
echo "Content-Type: text/plain"
echo ""

echo "===== Daily Dev Report ====="
echo ""

# Disk usage
DISK=$(df / | awk 'NR==2 {print $5}' | sed 's/%//')
echo "Disk Usage:"
if [ "$DISK" -gt 75 ]; then
    echo "WARNING: Disk usage high at $DISK%"
else
    echo "OK: $DISK% used"
fi
echo ""

# Git status
echo "Git Status:"
UNCOMMITTED=0
for dir in "$PROJECTS_DIR"/*/; do
    if [ -d "$dir/.git" ]; then
        cd "$dir" || continue
        if [[ -n $(git status -s) ]]; then
            echo "$(basename "$dir"): uncommitted changes"
            ((UNCOMMITTED++))
        fi
    fi
done

if [ "$UNCOMMITTED" -eq 0 ]; then
    echo "All projects clean"
else
    echo "Total projects with changes: $UNCOMMITTED"
fi
echo ""

# Large downloads
echo "Large Downloads:"
LARGE=$(find "$DOWNLOADS_DIR" -size +100M 2>/dev/null | wc -l)
if [ "$LARGE" -gt 0 ]; then
    echo "$LARGE files over 100MB"
    find "$DOWNLOADS_DIR" -size +100M -exec ls -lh {} \; 2>/dev/null | awk '{print "  " $9 " (" $5 ")"}'
else
    echo "No large files"
fi
echo ""

# Backup status
echo "Backup Status:"
LATEST_BACKUP=$(ls -t "$BACKUPS_DIR"/*.tar.gz 2>/dev/null | head -1)
if [ -n "$LATEST_BACKUP" ]; then
    date -r "$LATEST_BACKUP" "+Last backup: %Y-%m-%d %H:%M"
else
    echo "No backups found"
fi
echo ""

echo "===== End of Report ====="

} | msmtp "$EMAIL_TO"