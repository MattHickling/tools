#!/bin/bash

PROJECTS_DIR="../Projects"

while true; do
    read -p "Enter project directory name (press Enter to list options): " ROOT_DIRECTORY

    if [ -z "$ROOT_DIRECTORY" ]; then
        echo "Available directories:"
        ls -la "$PROJECTS_DIR"
        continue
    fi

    TARGET="$PROJECTS_DIR/$ROOT_DIRECTORY"

    if [ ! -d "$TARGET" ]; then
        echo "Directory not found."
        ls -la "$PROJECTS_DIR"
        continue
    fi

    cd "$TARGET" || exit 1
    break
done

if [ ! -d ".git" ]; then
    echo "This directory is not a git repository."
    exit 1
fi

LOG_DIR="$HOME/Library/Logs/git-repo-status"
mkdir -p "$LOG_DIR"

{
    git status
    git branch
    git log --oneline
} > "$LOG_DIR/${ROOT_DIRECTORY}.log"

