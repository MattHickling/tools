#!/bin/bash
PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"

PROJECTS_DIR="$HOME/Projects"
LOG_DIR="$HOME/Library/Logs/git-repo-status"

mkdir -p "$LOG_DIR"

for TARGET in "$PROJECTS_DIR"/*; do
    # Skip if not a directory
    [ -d "$TARGET" ] || continue

    # Check if it is a git repo
    if [ ! -d "$TARGET/.git" ]; then
        continue
    fi

    PROJECT_NAME=$(basename "$TARGET")
    LOG_FILE="$LOG_DIR/${PROJECT_NAME}.log"

    dt=$(date '+%d/%m/%Y %H:%M:%S')

    {
        echo "===== $dt ====="
        cd "$TARGET" || exit 1
        git status
        git branch
        git log --oneline
        echo
    } >> "$LOG_FILE"

done

